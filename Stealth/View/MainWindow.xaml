<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ignore="http://www.galasoft.ch/ignore"
        xmlns:controls="clr-namespace:Stealth.Controls"
        x:Class="Stealth.MainWindow"
        mc:Ignorable="d ignore"
        Height="600" Width="650" MinWidth="420" MinHeight="320" Background="{StaticResource Background.Main}"
        Title="Stealth">

    <Window.DataContext>
        <Binding Path="Main" Source="{StaticResource Locator}"/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto" MinHeight="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- The filtered count lives at the right edge of the menu strip. -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        Margin="8,0,12,0" VerticalAlignment="Center"
                        TextElement.FontSize="13"
                        TextElement.Foreground="{StaticResource Text.Main}">
                <TextBlock Text="{DynamicResource WindowCount.Showing}" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding VisibleWindowCount}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource WindowCount.Between}" Margin="6,0,6,0"/>
                <TextBlock Text="{Binding TotalWindowCount}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource WindowCount.Unit}" Margin="4,0,0,0"/>
            </StackPanel>
            <Menu x:Name="MainMenu" IsMainMenu="True"
                  FontSize="14" Background="Transparent"
                  Foreground="{StaticResource Text.Main}">
                <MenuItem Header="{DynamicResource Menu.Settings}">
                    <MenuItem Header="{DynamicResource Menu.Language}">
                        <MenuItem x:Name="EnglishLanguageMenu" Header="English"
                                  IsCheckable="True" Click="EnglishLanguageMenu_Click"/>
                        <MenuItem x:Name="ChineseLanguageMenu" Header="简体中文"
                                  IsCheckable="True" Click="ChineseLanguageMenu_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu.About}" Command="{Binding AboutCommand}"/>
                    <MenuItem Header="{DynamicResource Menu.Exit}" Command="{Binding ExitCommand}"/>
                </MenuItem>
            </Menu>
        </DockPanel>
        <!--筛选框-->
        <TextBox Grid.Row="1" x:Name="textFilterInput" Margin="4,2,4,0"
                 Text="{Binding TitleFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <!-- Option labels flow to the next line on narrow windows. -->
        <DockPanel Grid.Row="2" Margin="4,2,4,2" LastChildFill="True" MinHeight="36">
            <Button DockPanel.Dock="Right" Content="{DynamicResource Action.Refresh}"
                    Command="{Binding RefreshCommand}" MinWidth="80" Margin="4,0,0,0"/>
            <Border BorderThickness="1" BorderBrush="{StaticResource Border.Main}"
                    CornerRadius="4" Padding="4,2">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="includeRemovedCheckBox" Content="{DynamicResource Filter.Closed}"
                              Margin="4,3,10,3" VerticalAlignment="Center"
                              IsChecked="{Binding includeRemoved, Mode=TwoWay}"/>
                    <CheckBox x:Name="includeEmptyTitleCheckBox" Content="{DynamicResource Filter.Empty}"
                              Margin="4,3,10,3" VerticalAlignment="Center"
                              IsChecked="{Binding includeEmptyTitle, Mode=TwoWay}"/>
                    <CheckBox x:Name="overlayEnabledCheckBox" Content="{DynamicResource Overlay.Enable}"
                              Margin="4,3,8,3" VerticalAlignment="Center"
                              IsChecked="{Binding IsOverlayEnabled, Mode=TwoWay}"/>
                </WrapPanel>
            </Border>
        </DockPanel>
        <ListBox Grid.Row="3"
                  ItemsSource="{Binding WindowsView}"
                 HorizontalContentAlignment="Stretch"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.PanningMode="VerticalOnly"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Background.Block}" 
                            BorderBrush="{StaticResource Border.Main}"
                            BorderThickness="1" Margin="0,2"
                            CornerRadius="8" >
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Action.Restore}"
                                          Command="{Binding Main.RestoreCommand, Source={StaticResource Locator}}"
                                          CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid MinHeight="80">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="44"/>
                                <RowDefinition Height="Auto" MinHeight="36"/>
                            </Grid.RowDefinitions>
                            <!--缩略图-->
                            <Image Source="{Binding ProcIcon}" Grid.RowSpan="2" Margin="8,8,4,8"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <!-- The border preserves the original title-strip styling.
                                     A finite star column + disabled horizontal scrolling lets
                                     long paths wrap, then trim after the second line. -->
                                <Border Grid.Column="0" Margin="4,4,4,0" Padding="5,2,4,2"
                                        Background="{StaticResource Background.Main}"
                                        CornerRadius="4" ClipToBounds="True">
                                    <controls:TwoLineEllipsisText Text="{Binding Title}"
                                                                 Foreground="{StaticResource Text.Main}"
                                                                 FontSize="14"
                                                                 Height="36"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="{Binding Title}"
                                                                 AutomationProperties.Name="{Binding Title}"/>
                                </Border>
                                <Button Content="{DynamicResource Action.Detail}" Grid.Column="1" Margin="0,4,4,0"
                                        Command="{Binding Main.DetailCommand, 
                                                  Source={StaticResource Locator}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                            <Grid Grid.Column="1" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{DynamicResource Action.Topmost}" IsChecked="{Binding IsTopMost, Mode=TwoWay}"
                                          ToolTip="{Binding TopMostError}"
                                          Grid.Column="0" Margin="4,0"/>
                                <Slider Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="32" Maximum="255" Grid.Column="1"
                                        ToolTip="{Binding OpacityError}"
                                        VerticalAlignment="Center"/>
                                <Label Content="{Binding Opacity}" Grid.Column="2" Margin="0,4,4,4"/>
                            </Grid>
                        </Grid>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</Window>
