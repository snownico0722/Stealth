<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ignore="http://www.galasoft.ch/ignore"
        x:Class="Stealth.MainWindow"
        mc:Ignorable="d ignore"
        Height="600" Width="650" Background="{StaticResource Background.Main}"
        Title="Stealth">

    <Window.DataContext>
        <Binding Path="Main" Source="{StaticResource Locator}"/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <!--菜单栏-->
        <Menu Grid.Row="0" x:Name="MainMenu" IsMainMenu="True" 
              FontSize="14" Background="Transparent" 
              Foreground="{StaticResource Text.Main}">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.Exit}" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem Header="{DynamicResource Menu.About}" Command="{Binding AboutCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Language}">
                <MenuItem x:Name="EnglishLanguageMenu" Header="English" IsCheckable="True" Click="EnglishLanguageMenu_Click"/>
                <MenuItem x:Name="ChineseLanguageMenu" Header="简体中文" IsCheckable="True" Click="ChineseLanguageMenu_Click"/>
            </MenuItem>
        </Menu>
        <!--筛选框-->
        <TextBox Grid.Row="1" x:Name="textFilterInput" Margin="4,2,4,0"
                 Text="{Binding TitleFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <!--选项-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="1" BorderBrush="{StaticResource Border.Main}"
                    CornerRadius="4" Grid.ColumnSpan="3" Margin="4,4,0,4"/>
            <CheckBox x:Name="includeRemovedCheckBox" Content="{DynamicResource Filter.Closed}"
                      Grid.Column="0" Margin="8,0,0,0"
                      IsChecked="{Binding includeRemoved, Mode=TwoWay}"/>
            <CheckBox x:Name="includeEmptyTitleCheckBox" Content="{DynamicResource Filter.Empty}"
                      Grid.Column="1" Margin="4,0"
                      IsChecked="{Binding includeEmptyTitle, Mode=TwoWay}"/>
            <CheckBox x:Name="overlayEnabledCheckBox" Content="{DynamicResource Overlay.Enable}"
                      Grid.Column="2" Margin="4,0"
                      IsChecked="{Binding IsOverlayEnabled, Mode=TwoWay}"/>
            <Button Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}"
                    Grid.Column="3" Margin="4"/>
        </Grid>
        <ListBox Grid.Row="3"
                  ItemsSource="{Binding WindowsView}"
                 HorizontalContentAlignment="Stretch"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Background.Block}" 
                            BorderBrush="{StaticResource Border.Main}"
                            BorderThickness="1" Margin="0,2"
                            CornerRadius="8" >
                        <Grid Height="72">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!--缩略图-->
                            <Image Source="{Binding ProcIcon}" Grid.RowSpan="2" Margin="8,8,4,8"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Label Margin="4,4,4,0" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                </Label>
                                <Button Content="{DynamicResource Action.Detail}" Grid.Column="1" Margin="0,4,4,0"
                                        Command="{Binding Main.DetailCommand, 
                                                  Source={StaticResource Locator}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                            <Grid Grid.Column="1" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{DynamicResource Action.Topmost}" IsChecked="{Binding IsTopMost, Mode=TwoWay}"
                                          Grid.Column="0" Margin="4,0"/>
                                <Slider Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Maximum="255" Grid.Column="1"
                                        ToolTip="{Binding OpacityError}"
                                        VerticalAlignment="Center"/>
                                <Label Content="{Binding Opacity}" Grid.Column="2" Margin="0,4,4,4"/>
                            </Grid>
                        </Grid>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--状态栏-->
        <StatusBar x:Name="MainStatus" Grid.Row="4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding windowsInfoItemList.Count}"/>
            </StatusBarItem>
            <Separator Grid.Column="1"/>
            <StatusBarItem Grid.Column="2"/>
            <Separator Grid.Column="3"/>
            <StatusBarItem Grid.Column="4">
                <TextBlock Text="{DynamicResource Status.Ready}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>

</Window>
